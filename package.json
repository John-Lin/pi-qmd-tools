{
  "name": "pi-qmd-tools",
  "version": "0.1.0",
  "description": "qmd search tools (query/get/multi-get) as pi-agent AgentTools. Runs the qmd SDK in-process so the host's GPU and SQLite are used directly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "^0.70.2",
    "@mariozechner/pi-ai": "^0.70.2"
  },
  "dependencies": {
    "@tobilu/qmd": "^2.1.0",
    "typebox": "^1.1.24"
  }
}
